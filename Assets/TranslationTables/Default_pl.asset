    m_Metadata:
      m_Items: []
  - m_Id: 294954540466176
    m_Localized: TEAM
    m_Metadata:
      m_Items: []
  - m_Id: 295151232352256
    m_Localized: "Pofruwaj t\u0105 szybk\u0105 i lekk\u0105 maszyn\u0105."
    m_Metadata:
      m_Items: []
  - m_Id: 295283629752320
    m_Localized: "Odle\u0107 tym uniwersalnym i wszechstronnym wozem."
    m_Metadata:
      m_Items: []
  - m_Id: 295372007931904
    m_Localized: Szybki, zwinny i trudny w prowadzeniu.
    m_Metadata:
      m_Items: []
  - m_Id: 295438915469312
    m_Localized: "Przygotuj si\u0119 na naprawd\u0119 ostr\u0105 jazd\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 295548877537280
    m_Localized: "Ten w\xF3z przeczy zasadom grawitacji."
    m_Metadata:
      m_Items: []
  - m_Id: 295618981134336
    m_Localized: Szybko, szybko i jeszcze raz szybko!
    m_Metadata:
      m_Items: []
  - m_Id: 298206963171328
    m_Localized: "Silny, l\u015Bni\u0105cy - ten kot ma niez\u0142y pazur."
    m_Metadata:
      m_Items: []
  - m_Id: 298303369248768
    m_Localized: "Ta 'pla\u017Cowa' maszyna nadaje si\u0119 na ka\u017Cd\u0105 tras\u0119."
    m_Metadata:
      m_Items: []
  - m_Id: 298403818635264
    m_Localized: "Brutalna si\u0142a nie jest rozwi\u0105zaniem?"
    m_Metadata:
      m_Items: []
  - m_Id: 298478489829376
    m_Localized: Szybka i pewna maszyna.
    m_Metadata:
      m_Items: []
  - m_Id: 298528146194432
    m_Localized: "Niesamowity w\xF3z 4x4 - moc i szybko\u015B\u0107 w jednym."
    m_Metadata:
      m_Items: []
  - m_Id: 298610115477504
    m_Localized: Bardzo lekka i bardzo zwinna.
    m_Metadata:
      m_Items: []
  - m_Id: 298667858460672
    m_Localized: "Pan ka\u017Ce, ma\u0142pa robi! Przygotuj si\u0119 na naprawd\u0119
      dzik\u0105 jazd\u0119!"
    m_Metadata:
      m_Items: []
  - m_Id: 298774418948096
    m_Localized: "Ognisty demon pr\u0119dko\u015Bci!"
    m_Metadata:
      m_Items: []
  - m_Id: 298840118525952
    m_Localized: "Mo\u017Ce na to nie wygl\u0105da, ale ma szybko\u015B\u0107 rozwidlonej
      b\u0142yskawicy!"
    m_Metadata:
      m_Items: []
  - m_Id: 298965389803520
    m_Localized: Super szybki wozik!
    m_Metadata:
      m_Items: []
  - m_Id: 299068322217984
    m_Localized: Niewiarygodnie szybki bolid.
    m_Metadata:
      m_Items: []
  - m_Id: 299164162064384
    m_Localized: "Idea\u0142 - pot\u0119\u017Cny, uniwersalny w\xF3z."
    m_Metadata:
      m_Items: []
  - m_Id: 299809069858816
    m_Localized: "opu\u015Bci\u0142 serwer"
